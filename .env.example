# Copie para .env e preencha para rodar localmente.
# O script le variaveis de ambiente diretamente (nao carrega .env sozinho;
# exporte-as no shell ou use `set -a; source .env; set +a`).

# Codigo da unidade no site do SESC PR (34 = default no script)
SESC_COD_MEIO_HOSPEDAGEM=34

# Nome exibido nas notificacoes e no /status
SESC_NOME_UNIDADE=Sesc PR

# Notificar tambem dias soltos de FDS liberados, mesmo sem formar estadia completa
SESC_DIA_SOLTO=true

# Onde gravar o snapshot de estado
SESC_STATE_FILE=estado.json

# Token do bot no @BotFather e chat_id para onde notificar
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
